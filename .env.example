# Environment Variables untuk Sistem Manajemen Pesanan
# Copy file ini ke .env dan isi nilai yang sesuai

# Database
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db_mpem

# WhatsApp Gateway
WA_API_URL=http://127.0.0.1:2785/api
WA_API_KEY=your_wa_api_key_here
WA_SESSION_NAME=marketing-zahra

# Security
NOTIF_SECRET=your_random_secret_key_here
